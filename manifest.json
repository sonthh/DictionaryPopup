{
  "name": "Dictionary Popup",
  "author": "tranhuuhongson@gmail.com",
  "description": "Look up vocabularies on a pop-up window by mouse and pressing events with multiple types of online-dictionary",
  "version": "1.0.0",
  "manifest_version": 2,
  "icons": {
    "128": "icon_128.png",
    "16": "icon_16.png",
    "48": "icon_48.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "background": {
    "persistent": false,
    "scripts": [
      "js/sharedScript.js",
      "js/background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon_16.png",
    "default_popup": "html/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ldoceonline.com/*",
        "https://www.oxfordlearnersdictionaries.com/*",
        "https://dictionary.cambridge.org/dictionary/english/*",
        "https://www.google.com/search?tbm=isch&q=*"
      ],
      "js": [
        "js/sharedScript.js",
        "js/content.js"
      ],
      "css": [
        "css/main.css"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/sharedScript.js",
        "js/contentAll.js"
      ]
    }
  ]
}